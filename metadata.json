{
  "name": "miharp-codavox",
  "version": "0.1.0",
  "author": "Michael Harp",
  "summary": "Distributes versioned Puppet code to OpenVox compilers via codavox",
  "license": "Apache-2.0",
  "source": "https://github.com/miharp/puppet-codavox",
  "project_page": "https://github.com/miharp/codavox",
  "issues_url": "https://github.com/miharp/puppet-codavox/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/inifile",
      "version_requirement": ">= 5.0.0 < 7.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "openvox",
    "puppetserver",
    "static-catalogs",
    "code-management",
    "r10k",
    "codavox"
  ]
}
